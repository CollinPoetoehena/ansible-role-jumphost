# ===========================================================================
# # {{ ansible_managed }} — DO NOT EDIT MANUALLY
# Role: devhub-ansible-jumphost
# ===========================================================================
# SSH daemon configuration for a hardened jumphost (e.g. a Raspberry Pi router)
# This file is fully generated by Ansible templates.
# To modify settings, update role variables and re-run the playbook.
# ===========================================================================

# ---------------------------------------------------------------------------
# Network Listener Configuration
# ---------------------------------------------------------------------------
# Listen on the default SSH port
Port 22
# Listen on all network interfaces (WAN + VLAN 10)
ListenAddress 0.0.0.0

# ---------------------------------------------------------------------------
# Logging & Auditing
# ---------------------------------------------------------------------------
# VERBOSE logs the fingerprint of every key used for authentication
# Useful for auditing and detecting unauthorized access attempts
LogLevel VERBOSE

# ---------------------------------------------------------------------------
# Authentication Controls
# ---------------------------------------------------------------------------
# Time (in seconds) allowed for clients to authenticate
LoginGraceTime {{ ssh_login_grace_time }}

# Disallow root login over SSH for security
PermitRootLogin no

# Enforce strict file permission checks for user home directories
StrictModes yes

# Maximum number of authentication attempts permitted per connection
MaxAuthTries {{ ssh_max_auth_tries }}

# Maximum number of open sessions permitted per network connection
MaxSessions {{ ssh_max_sessions }}

# Only allow public key authentication (no passwords)
PubkeyAuthentication yes

# File containing authorized public keys for users
AuthorizedKeysFile .ssh/authorized_keys

# Disable password-based login entirely — only SSH keys can authenticate
# Without this, attackers can still brute-force passwords over the network.
PasswordAuthentication no

# Do not allow empty passwords
PermitEmptyPasswords no

# Disables challenge-response mechanisms (e.g. one-time passwords, keyboard-interactive prompts).
# If left enabled, PAM or other modules can still prompt for a password even when PasswordAuthentication 
# is off, bypassing your key-only policy.
ChallengeResponseAuthentication no

# ---------------------------------------------------------------------------
# PAM (Pluggable Authentication Modules)
# ---------------------------------------------------------------------------
# Keep PAM enabled for additional authentication policies.
# Required on Debian/Raspberry Pi OS for key-based login, do NOT set this to "no":
#  On Debian-based systems (including Raspberry Pi OS), OpenSSH 10.x rejects
#  pubkey login for accounts without a password (locked accounts like ansibleremote)
#  when PAM is disabled. With UsePAM yes + PasswordAuthentication no, PAM does NOT
#  allow password login — it only handles account validation and session setup,
#  which correctly permits key-based auth for locked service accounts.
UsePAM yes

# ---------------------------------------------------------------------------
# Forwarding Controls
# ---------------------------------------------------------------------------
# Agent forwarding (optional) — required for ProxyJump or SSH hopping
AllowAgentForwarding {{ 'yes' if enable_ssh_agent_forwarding else 'no' }}

# TCP forwarding must be enabled for ProxyJump (-J with SSH) to work
AllowTcpForwarding yes

# Disable X11 forwarding to minimize attack surface
X11Forwarding no

# ---------------------------------------------------------------------------
# Session Keepalive
# ---------------------------------------------------------------------------
# Disconnect idle sessions after (interval * count_max) seconds
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

# ---------------------------------------------------------------------------
# Access Restrictions
# ---------------------------------------------------------------------------
{% if ssh_allowed_users | length > 0 %}
# Only allow SSH login for these users
AllowUsers {{ ssh_allowed_users | join(' ') }}
{% endif %}

# ---------------------------------------------------------------------------
# Miscellaneous/Other Settings
# ---------------------------------------------------------------------------
# Print last login information on login
PrintLastLog yes
