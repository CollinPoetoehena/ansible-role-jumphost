# Managed by Ansible — do not edit manually
# Role: ansible-role-jumphost

# This rsyslog configuration forwards all log messages generated by the SSH daemon (sshd)
# to a dedicated SSH audit log file. This helps separate SSH activity from other system logs
# for easier auditing and monitoring.

# If the program name of the log message is 'sshd', then:
if $programname == 'sshd' then {
    # Write the log message to the specified SSH audit log file
    action(type="omfile" file="{{ audit_log_path }}")
    # Stop further processing of this message (prevents it from being logged elsewhere)
    stop
}
